# Study Bunny cloud-api environment variables (names only — no values committed).
# Set these at deploy time (SAM parameters / Lambda configuration).

# Confirm an active in-region Anthropic InvokeModel ID in the deployment account.
BEDROCK_MODEL_ID=

# Exact allowed CORS origin for the frontend (e.g. https://app.example.com).
ALLOWED_ORIGIN=

# SAM creates and sets the table; do not leave blank in a production Lambda.
QUOTA_TABLE=
DAILY_REQUEST_LIMIT=20

# NOTE: AWS_REGION is provided automatically by the Lambda runtime; do not set it here.
