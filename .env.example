# Study Bunny frontend environment (names only — deployment config, not a secret).
# Copy to .env.local and set the value to the deployed HTTP API invoke URL
# (the cloud-api stack's ApiBaseUrl output). Leave all four blank for offline mode.
# Public build-time configuration; never put secrets or AWS credentials here.
VITE_API_BASE_URL=

# SAM stack outputs. Public client configuration, never AWS credentials.
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
