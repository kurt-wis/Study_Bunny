# Study Bunny environment. Leave everything blank for offline mode.

# ── Frontend (public, build-time) ────────────────────────────────────────────
# Only needed when the API is hosted on a different origin than the app.
# On Vercel the app and its /api routes share one origin, so leave this blank.
VITE_API_BASE_URL=

# ── Server (Vercel → Settings → Environment Variables). NEVER prefix with VITE_.
# Which AI service to use: gemini | groq | openai | openrouter | anthropic
# gemini and groq have free tiers (rate-limited); openai and anthropic are paid.
AI_PROVIDER=
# The API key from that service.
AI_API_KEY=
# The model ID to call. Copy it from that service's current model list.
AI_MODEL=
# Optional. Shared code students type in Profile to use Cloud AI. Pick a long,
# unguessable one. Leave blank for an open demo: no code needed, but anyone who
# opens the site can spend your AI allowance.
ACCESS_CODE=
# AI requests allowed per student device per day.
DAILY_REQUEST_LIMIT=20
# Optional: another OpenAI-compatible endpoint, and "off" if it rejects JSON mode.
AI_BASE_URL=
AI_JSON_MODE=
# Optional: Upstash Redis (REST) for an accurate daily limit across server instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
